# Porta publicada no servidor Docker.
PORTAL_PORT=3000

# Imagem pronta publicada automaticamente pelo GitHub Actions.
IMAGE_NAME=ghcr.io/gustavodevgti/central-de-servicos-amargosa:latest

# Assistente virtual Amanda. A chave permanece somente no servidor.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Para usar a OpenAI como alternativa:
# AI_PROVIDER=openai
# AI_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=

AI_MAX_OUTPUT_TOKENS=400
AI_TIMEOUT_MS=25000
AI_RATE_LIMIT_MESSAGES=10
AI_DAILY_SESSION_LIMIT=30
AI_MONTHLY_BUDGET_BRL=100
# Atualize esta cotação para manter a estimativa de orçamento conservadora.
AI_USD_TO_BRL=6
