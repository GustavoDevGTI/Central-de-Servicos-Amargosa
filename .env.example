# Porta publicada no servidor Docker.
PORTAL_PORT=3000

# Imagem pronta publicada automaticamente pelo GitHub Actions.
IMAGE_NAME=ghcr.io/gustavodevgti/central-de-servicos-amargosa:latest

# Endereço externo exato usado no navegador, sem caminho adicional.
BETTER_AUTH_URL=https://maisdigital.amargosa.ba.gov.br
# Host externo autorizado no proxy, sem https:// nem caminho.
VINEXT_TRUSTED_HOSTS=maisdigital.amargosa.ba.gov.br
# Gere valores distintos com: openssl rand -hex 32
# Use caracteres hexadecimais no POSTGRES_PASSWORD para compor a URL do banco.
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# Somente no primeiro início do banco vazio. Remova após criar o administrador.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=GTI
BOOTSTRAP_ADMIN_PASSWORD=

# Assistente virtual Amanda. A chave permanece somente no servidor.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Para usar a OpenAI como alternativa:
# AI_PROVIDER=openai
# AI_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=

AI_MAX_OUTPUT_TOKENS=800
AI_TIMEOUT_MS=25000
AI_RATE_LIMIT_MESSAGES=10
AI_DAILY_SESSION_LIMIT=30
AI_MONTHLY_BUDGET_BRL=100
# Atualize esta cotação para manter a estimativa de orçamento conservadora.
AI_USD_TO_BRL=6
# Tarifas estimadas em USD por milhão de tokens. Atualize ao trocar de modelo ou preço.
AI_INPUT_USD_PER_MILLION=0.3
AI_CACHED_INPUT_USD_PER_MILLION=0.006
AI_OUTPUT_USD_PER_MILLION=1.2
